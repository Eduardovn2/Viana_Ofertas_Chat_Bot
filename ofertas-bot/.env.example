# Copie este arquivo para .env e preencha os valores locais.
# Gere senhas/chaves diferentes com: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL local do Docker Compose. Nunca use estes valores de exemplo como senha.
POSTGRES_DB=ofertas_bot
POSTGRES_USER=ofertas_bot
POSTGRES_PASSWORD=
# Use a mesma senha acima na URL. Se a senha tiver caracteres especiais, codifique-a para URL.
DATABASE_URL=postgresql+psycopg://ofertas_bot:SUBSTITUA_SENHA@127.0.0.1:5432/ofertas_bot

# Obrigatória nas rotas administrativas: configure uma chave aleatória de ao menos 32 caracteres.
# O valor vazio mantém o acesso administrativo bloqueado.
ADMIN_API_KEY=

# Único provedor disponível nesta entrega. Os valores gerados NÃO representam ofertas reais.
PRICE_PROVIDER=simulated
MOCK_CURRENT_PRICE=99.90

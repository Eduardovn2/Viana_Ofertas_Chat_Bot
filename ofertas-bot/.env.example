# Copie este arquivo para .env e preencha os valores locais.
# Gere senhas/chaves diferentes com: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL local do Docker Compose. Nunca use estes valores de exemplo como senha.
POSTGRES_DB=ofertas_bot
POSTGRES_USER=ofertas_bot
POSTGRES_PASSWORD=
# Use a mesma senha acima na URL. Se a senha tiver caracteres especiais, codifique-a para URL.
DATABASE_URL=postgresql+psycopg://ofertas_bot:SUBSTITUA_SENHA@127.0.0.1:5432/ofertas_bot

# Obrigatória nas rotas administrativas: configure uma chave aleatória de ao menos 32 caracteres.
# O valor vazio mantém o acesso administrativo bloqueado.
ADMIN_API_KEY=

# Padrão sem rede. Use marketplaces somente após obter autorização por plataforma.
PRICE_PROVIDER=simulated
MOCK_CURRENT_PRICE=99.90
MOCK_AVAILABILITY=AVAILABLE
MOCK_PRICE_ACCESS=PUBLIC
# MOCK_PREVIOUS_PRICE=120.00

# Scheduler simulado; APP_ENV=test bloqueia suas threads em testes.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=1
PRIORITY_INTERVAL_SECONDS=60
GENERAL_INTERVAL_SECONDS=300
PROVIDER_MIN_INTERVAL_SECONDS=1
MONITORING_LEASE_SECONDS=120
MONITORING_BACKOFF_MAX_SECONDS=3600
PRICE_MAX_AGE_SECONDS=600
# Nunca abaixo de três horas.
QUEUE_REPUBLISH_SECONDS=10800
MAX_QUEUE_ATTEMPTS=3

SCORE_PRICE_DROP=40
SCORE_CONFIRMED_COUPON=30
SCORE_PRIORITY=20
SCORE_DISCOUNT_PERCENT=1
SCORE_AVAILABILITY=5

# Fase 3: opcionais, independentes e desativados. Nunca cole segredos no chat/logs.
MERCADO_LIVRE_ENABLED=false
MERCADO_LIVRE_ACCESS_TOKEN=
# OAuth local e opcional: prepare o callback com scripts/start_oauth_tunnel.ps1.
# Cadastre no DevCenter a URI exata gravada pelo script; preencha credenciais só neste arquivo local.
# Habilite apenas após configurar a própria aplicação e decidir autorizar a conta no navegador.
# Estes nomes MERCADOLIVRE_* são independentes das flags comerciais MERCADO_LIVRE_* acima.
MERCADOLIVRE_OAUTH_ENABLED=false
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
MERCADOLIVRE_PKCE_ENABLED=true
MERCADOLIVRE_OAUTH_STATE_TTL_SECONDS=600
# Tokens OAuth são protegidos por DPAPI no perfil Windows; nunca cole tokens neste exemplo.
SHOPEE_ENABLED=false
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Conversão só após confirmar a permissão da conta. Mercado Livre continua manual.
SHOPEE_SHORT_LINKS_ENABLED=false
SHOPEE_DISCOVERY_ENABLED=false
# Query obrigatória quando habilitar descoberta automática (primeira página, até 10 itens/ciclo).
# SHOPEE_DISCOVERY_QUERY=ferramentas
INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_MAX_RETRIES=1
INTEGRATION_MIN_INTERVAL_SECONDS=1
INTEGRATION_CACHE_SECONDS=30
INTEGRATION_MAX_RETRY_WAIT_SECONDS=5

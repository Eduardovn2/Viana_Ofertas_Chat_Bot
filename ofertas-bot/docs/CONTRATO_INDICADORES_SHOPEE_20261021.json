      ],
      "returnType": "ItemFeedListConnection",
      "desc": "Get available item feed metadata list.\n    Use this to discover available feeds before fetching actual data.\n    Returns feed metadata including ID, date, total count, and feed mode (FULL/DELTA)."
    },
    {
      "name": "getItemFeedData",
      "opType": "query",
      "args": [
        {
          "name": "datafeedId",
          "type": "String",
          "isList": false,
          "required": true,
          "defaultValue": "",
          "description": "Composite datafeed ID obtained from listItemFeeds (format: {datafeedId}_{feedMode}_{grassDate}, e.g. \"12345_FULL_20260205\")",
          "enumName": ""
        },
        {
          "name": "offset",
          "type": "Int",
          "isList": false,
          "required": false,
          "defaultValue": "0",
          "description": "Pagination offset (starts from 0)",
          "enumName": ""
        },
        {
          "name": "limit",
          "type": "Int",
          "isList": false,
          "required": false,
          "defaultValue": "500",
          "description": "Number of records per page (max 500)",
          "enumName": ""
        }
      ],
      "returnType": "ItemFeedDataConnection",
      "desc": "Fetch item feed data with pagination.\n    Use datafeedId from listItemFeeds to retrieve actual product data.\n    Supports both FULL sync (complete dataset) and DELTA sync (incremental changes).\n    DELTA mode includes updateType field (NEW/UPDATE/DELETE) for each row."
    }
